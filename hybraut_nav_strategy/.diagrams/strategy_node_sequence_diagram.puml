@startuml StrategyNodeSequenceDiagram
    actor Client
    participant StrategyNode
    participant Planner
    participant Publisher

    Client -> StrategyNode: send_goal(goal_pose)
    StrategyNode -> Planner: plan_path(start, goal)
    Planner --> StrategyNode: path
    StrategyNode -> Publisher: publish(path)
    StrategyNode --> Client: response(success)

    par Replanning and Client Cancel
        loop while not goalReached
            StrategyNode -> Planner: plan_path(start, goal)
            Planner --> StrategyNode: path
            StrategyNode -> Publisher: publish(path)
        end

        Client -> StrategyNode: cancel_goal()
        StrategyNode -> StrategyNode: cancel_goal()
    end
@enduml
