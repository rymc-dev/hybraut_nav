{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Hybrid Automaton Framework Schema",
    "description": "This schema defines the structure for validating JSON data related to the Hybrid Automaton Configuration",
    "version": "1.0.0",
    "type": "object",
    "properties": {
        "states": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z0-9_]+$": {
              "type": "object",
              "required": ["topic", "type"],
              "properties": {
                "topic": {
                  "type": "string"
                },
                "type": {
                  "type": "object",
                  "required": ["pkg", "msg"],
                  "properties": {
                    "pkg": { "type": "string" },
                    "msg": { "type": "string" }
                  },
                  "additionalProperties": false
                },
                "params": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 1,
                    "patternProperties": {
                      "^(update_hz|timeout_sec|buffer_size)$": { "type": "number" }
                    },
                    "additionalProperties": false
                  }
                },
                "configuration": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": true
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "resets": {
            "type": "object",
            "patternProperties": {
              "^[a-zA-Z0-9_]+$": {
                "type": "object",
                "required": ["module", "class_name", "state_inputs", "state_outputs"],
                "properties": {
                    "module": {"type": "string"},
                    "class_name": {"type": "string"},
                    "state_inputs": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "state_outputs": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "configuration": {
                      "oneOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        }
                      ]
                    }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
        "guards": {
          "type": "object",
          "patternProperties": {
          "^[a-zA-Z0-9_]+$": {
              "type": "object",
              "required": ["module", "class_name", "state_inputs"],
              "properties": {
                  "module": {"type": "string"},
                  "class_name": {"type": "string"},
                  "state_inputs": {
                      "type": "array",
                      "items": {
                          "type": "string"
                      }
                  },
                  "configuration": {
                    "oneOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": true
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": true
                      }
                    ]
                  }
              },
              "additionalProperties": false
          }
          },
          "additionalProperties": false
      },
      "invariants": {
          "type": "object",
          "patternProperties": {
          "^[a-zA-Z0-9_]+$": {
              "type": "object",
              "required": ["module", "class_name"],
              "properties": {
                  "module": {"type": "string"},
                  "class_name": {"type": "string"},
                  "state_inputs": {
                      "type": "array",
                      "items": {
                          "type": "string"
                      }
                  },
                  "configuration": {
                    "oneOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": true
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": true
                      }
                    ]
                  }
              },
              "additionalProperties": false
          }
          },
          "additionalProperties": false
      },
      "transitions": {
          "type": "object",
          "patternProperties": {
              "^[a-zA-Z0-9_:]+$": {
                  "type": "object",
                  "properties": {
                      "guard": {"type": "string"},
                      "reset": {
                        "oneOf": [
                          {"type": "string"},
                          {"type": "null"}
                        ]
                      },
                      "configuration": {
                        "oneOf": [
                          {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            }
                          },
                          {
                            "type": "object",
                            "additionalProperties": true
                          }
                        ]
                      }
                  },
              "additionalProperties": false
              }
          },
          "additionalProperties": false
      },
      "dynamics": {
          "type": "object",
          "properties": {
            "dynamic_parameters": {
              "type": "object",
              "properties": {
                "dynamic_parameter_names": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "dynamic_parameter_value_types": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "dynamic_parameter_metrics": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              },
              "additionalProperties": false
            },
            "dynamic_classes": {
              "type": "object",
              "patternProperties": {
                  "^[a-zA-Z0-9_]+$": {
                      "type": "object",
                      "required": ["module", "class_name"],
                      "properties": {
                          "module": {"type": "string"},
                          "class_name": {"type": "string"},
                          "state_inputs": {
                            "type": "array",
                            "items": {"type": "string"}
                          },
                          "configuration": {
                            "oneOf": [
                              {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "additionalProperties": true
                                }
                              },
                              {
                                "type": "object",
                                "additionalProperties": true
                              }
                            ]
                          }
                      },
                      "additionalProperties": false
                  }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
      },
      "modes": {
          "type": "object",
          "patternProperties": {
              "^[a-zA-Z0-9_]+$": {
                  "type": "object",
                  "properties": {
                      "index": {
                        "oneOf": [
                          {"type": "string"},
                          {"type": "integer"}
                        ]
                      },
                      "dynamics": {"type": "string"},
                      "invariants": {"type": "string"},
                      "transitions": {
                          "oneOf": [
                            {
                              "type": "object",
                              "patternProperties": {
                                "^[a-zA-Z0-9_]+$": {
                                  "type": "object",
                                  "required": ["priority"],
                                  "properties": {
                                    "priority": {
                                      "type": "integer",
                                      "minimum": 0
                                    }
                                  },
                                  "additionalProperties": false
                                }
                              },
                              "additionalProperties": false
                            },
                            {
                              "type": "array",
                              "items": {"type": "object"}
                            }
                          ]
                        },
                      "configuration": {
                        "oneOf": [
                          {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            }
                          },
                          {
                            "type": "object",
                            "additionalProperties": true
                          }
                        ]
                      }
                  },
                  "additionalProperties": false
              }
          },
          "additionalProperties": false
      },
      "goal_modes": {
          "type": "array",
          "items": {
              "type": "string"
          }
      },
      "initial_mode": {
          "type": "string"
      },
      "parameters": {
          "type": "object",
          "properties": {
            "goal_waypoint": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "object",
                  "properties": {
                    "pkg": {"type": "string"},
                    "msg": {"type": "string"}
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "evaluation_frequency": {
              "type": "object",
              "properties": {
                "type": {"type": "string"}
              },
              "additionalProperties": false
            },
            "control_frequency": {
              "type": "object",
              "properties": {
                "type": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
      }
    },
    "required": ["states", "resets", "guards", "invariants", "transitions", "dynamics", "modes", "goal_modes", "initial_mode", "parameters"]
}