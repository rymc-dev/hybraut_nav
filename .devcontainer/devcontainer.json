// dev container for the hybraut_ros2 package
{
	"name": "hybraut_ros2-devcontainer",
	"workspaceFolder": "/workspace/ros2_ws/src/hybraut_ros2",
	"workspaceMount": "source=${localWorkspaceFolder}/hybraut_ros2,target=/workspace/ros2_ws/src/hybraut_ros2,type=bind,consistency=cached",
	"build": {
		"dockerfile": "hybraut-ros2.dockerfile",
		"args": {
			"MODE": "dev"
		}
	},
	"runArgs": [
		"--network", "bridge" // bridged connection puts the container on the same network as the host meaning all ports can be accessed via localhost on container or external
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-toolsai.jupyter",
				"ms-azuretools.vscode-docker",
				"redhat.vscode-xml",
				"redhat.vscode-yaml",
				"ms-python.pylint"
			]
		},
		"settings": {
			"terminal.integrated.shell.linux": "/bin/bash",
			"python.languageServer": "Pylance",
			"python.analysis.typeCheckingMode": "basic",
			"python.formatting.provider": "black",
			"python.formatting.autoFormatOnSave": true
		},
		"remoteUser": "vscode"
	}
}