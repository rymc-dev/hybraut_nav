
# NavigateToGoal.action
# ROS2 action interface for strategy_node (Layer 1 - global planning). One
# goal = the whole mission: a single overall target. strategy_node plans a
# global route to it, then dispatches the resulting waypoints to
# tactical_node's own execute_mission action one leg at a time (see
# hybraut_nav/action/ExecuteMission.action) until the route is
# exhausted, replanning from the agent's current position if it drifts off
# the stored route mid-mission. Feedback carries both the live state of
# whichever leg is currently executing (relayed from tactical_node's own
# feedback) and mission-level progress across the whole route.

# Goal
builtin_interfaces/Time stamp
string mission_tag
hybraut_nav/Waypoint goal_waypoint   # overall target (x, y) for the mission

---
# Result
bool success
string message
builtin_interfaces/Duration total_mission_duration   # wall-clock time from goal accepted to this result

---

# Feedback
# -- mission-level progress --
hybraut_nav/Waypoint[] planned_waypoints          # current downsampled route (replaced wholesale on a replan)
uint32 current_waypoint_index                          # index into planned_waypoints of the leg now executing
float64 progress                                       # 0.0-1.0, distance-based fraction of the route completed
builtin_interfaces/Duration elapsed_time                # time since this mission's goal was accepted
builtin_interfaces/Duration estimated_time_remaining    # projected from distance-covered/elapsed-time so far;
                                                         # zero until at least one leg has completed (no speed
                                                         # estimate yet)
# -- relayed from the currently active tactical_node leg --
string tactical_automaton_state
builtin_interfaces/Duration tactical_time_since_last_transition
geometry_msgs/Point current_position
builtin_interfaces/Time stamp
