flowchart TD
    %% Inputs
    A["AMDL: Hybrid Automaton YAML Definition"] -->|defines blueprint| B["ACI: Automaton Component Implementations"]
    
    %% Compilation and passive model creation
    B -->|implement guards, resets, dynamics, invariants| C["HD: Hybrid Automaton Model (HM) - Passive Entity"]
    A -->|compile & combine with ACI| C
    C -->|wraps modes, transitions, registries, low-level logic| C

    %% Activation and runtime evaluation
    C -->|activate| D["HEE: Hybrid Execution Engine - Active Wrapper"]
    D -->|async evaluation, thread mgmt, watchdogs| D
    D -->|tick evaluation| E{"Mission Complete?"}
    
    %% Mission completion loop
    E -->|no| D
    E -->|yes| F["Deactivate HEE"]
    F --> C["HM remains passive"]

    %% Styling for clarity
    classDef passive fill:#f9f,stroke:#333,stroke-width:1px;
    classDef active fill:#9f9,stroke:#333,stroke-width:1px;
    class A,C passive
    class D active
